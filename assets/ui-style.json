{
  "styles": {
    ".btn": {
      "background": "$panel-2",
      "border": {
        "width": 1,
        "color": "#ffffff17",
        "style": "solid"
      },
      "radius": 12,
      "padding": {
        "top": 10,
        "end": 18,
        "bottom": 10,
        "start": 18
      },
      "minWidth": 44,
      "minHeight": 44,
      "text": {
        "color": "$text",
        "weight": "600",
        "align": "center"
      },
      "hovered": {
        "background": "$panel-2-hover"
      },
      "focusVisible": {
        "focusRing": {
          "width": 3,
          "color": "$focus-ring",
          "offset": 2
        }
      },
      "pressed": {
        "scale": 0.97
      },
      "disabled": {
        "opacity": 0.45
      }
    },
    ".btn-primary": {
      "background": "$accent",
      "border": {
        "color": "#00000000"
      },
      "text": {
        "color": "$ink-on-accent"
      },
      "hovered": {
        "background": "$accent-hover"
      }
    },
    ".btn-danger": {
      "background": "#57251d",
      "border": {
        "color": "#7d3a2e"
      },
      "hovered": {
        "background": "#6d3025"
      }
    },
    ".btn-ghost": {
      "background": "#00000000",
      "border": {
        "color": "#00000000"
      },
      "text": {
        "color": "$muted"
      },
      "hovered": {
        "background": "#ffffff0f",
        "text": {
          "color": "$text"
        }
      }
    },
    ".btn-big": {
      "padding": {
        "top": 16,
        "end": 30,
        "bottom": 16,
        "start": 30
      },
      "minHeight": 56,
      "text": {
        "size": 18.4
      }
    },
    ".btn-sm": {
      "padding": {
        "top": 5,
        "end": 12,
        "bottom": 5,
        "start": 12
      },
      "minHeight": 34,
      "text": {
        "size": 13.6
      }
    },
    ".btn-menu": {
      "background": "$panel-soft"
    },
    ".btn-action": {
      "padding": {
        "top": 10,
        "end": 12,
        "bottom": 10,
        "start": 12
      }
    },
    ".btn-narrow": {
      "padding": {
        "top": 8,
        "end": 4,
        "bottom": 8,
        "start": 4
      },
      "minWidth": 48,
      "text": {
        "size": 12.8
      }
    },
    ".kbd": {
      "border": {
        "width": 1,
        "color": "$text",
        "style": "solid"
      },
      "radius": 4,
      "padding": {
        "top": 0,
        "end": 5,
        "bottom": 0,
        "start": 5
      },
      "opacity": 0.65,
      "text": {
        "color": "$text",
        "size": 11.5
      }
    },
    ".kbd-plain": {
      "background": "$panel-2",
