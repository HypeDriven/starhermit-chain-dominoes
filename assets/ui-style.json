      "radius": 4,
      "padding": {
        "top": 1,
        "end": 6,
        "bottom": 1,
        "start": 6
      },
      "text": {
        "color": "$text",
        "size": 13
      }
    },
    ".badge": {
      "background": "$accent-2",
